# ─────────────────────────────────────────────────────────────
# Plan Happy Wealth — Environment
# Copy to `.env.local` and fill in. The app runs fully on mock
# data when these are absent, so you can develop with zero keys.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO / OG / sitemap)
NEXT_PUBLIC_SITE_URL=https://planhappywealth.com

# ── Supabase (lead capture, assessment results) ──────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sanity (Education Hub content) ───────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=

# ── AI Financial Guide (optional — falls back to scripted guide) ─
# The guide runs client-side by default. For a server deploy with a live LLM,
# set this and implement callProvider() in src/app/api/ai-guide/route.ts
AI_GUIDE_API_KEY=

# ── Lead capture on static hosts (GitHub Pages) ──────────────
# Optional. With a Formspree form id, the consultation form posts there.
# Without it, the form still confirms (optimistic). For server deploys,
# use the Supabase keys above + the /api/lead route instead.
NEXT_PUBLIC_FORMSPREE_ID=

# ── GitHub Pages build (set by the deploy workflow) ──────────
# GITHUB_PAGES=true triggers static export + the /PlanHappyWealth base path.
# NEXT_PUBLIC_BASE_PATH is derived automatically from it.
